{
  "name": "outlist",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build --webpack",
    "start": "bun --bun next start",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint .",
    "test": "bun --bun vitest run",
    "test:auth-e2e": "bun --bun scripts/auth-e2e.mjs",
    "test:discovery-db": "bun --conditions=react-server scripts/discovery-db-integration.ts",
    "test:enrichment-db": "bun --conditions=react-server scripts/enrichment-db-integration.ts",
    "github:inspect": "bun --bun scripts/github-inspect.ts",
    "github:smoke": "bun --bun scripts/github-inspect.ts --live-smoke",
    "discover": "bun --conditions=react-server scripts/discover.ts",
    "enrich": "bun --conditions=react-server scripts/enrich.ts",
    "validate:data": "bun scripts/validate-data.mjs",
    "check": "bun run typecheck && bun run lint && bun run test && bun run validate:data && bun run build",
    "supabase": "bunx supabase",
    "supabase:db-test": "bun run supabase test db",
    "supabase:db-lint": "bun run supabase db lint --schema public,private --fail-on error",
    "supabase:types": "SUPABASE_TELEMETRY_DISABLED=1 bun run supabase gen types --lang=typescript > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.14 <1.4.0"
  }
}
