NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Operator label for the configured database target: local, development, staging, or production.
# The pipeline reports this label alongside the URL-derived host and project reference.
OUTLIST_SUPABASE_ENVIRONMENT=local
# Optional server-side token for GitHub REST API inspection, discovery and enrichment.
# Authenticated repository searches have their own GitHub Search API rate limit.
# Never rename this to NEXT_PUBLIC_GITHUB_TOKEN.
GITHUB_TOKEN=
